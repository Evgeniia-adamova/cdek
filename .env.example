# Yandex Object Storage (S3). Copy to .env and fill in; never commit .env
YANDEX_S3_BUCKET=your-bucket-name
YANDEX_S3_ACCESS_KEY_ID=your-access-key-id
YANDEX_S3_SECRET_ACCESS_KEY=your-secret-access-key

# Yandex SpeechKit (speech-to-text). Create in Console: Folder ID + API key (APIs → SpeechKit).
YANDEX_FOLDER_ID=your-folder-id
YANDEX_API_KEY=your-speechkit-api-key

# Optional: object key for pipeline video (e.g. video_files/xxx.webm). If unset, first video under video_files/ is used.
# YANDEX_VIDEO_KEY=video_files/your-video.webm

# Optional: object key for audio (e.g. after --extract-audio). If unset, first .ogg under audio_files/ is used.
# YANDEX_AUDIO_KEY=audio_files/video_from_bucket_audio.ogg

# Optional: diarization + sentiment (transcript_diarize_sentiment.py)
# Accept conditions at hf.co/pyannote/speaker-diarization-community-1 then create token at hf.co/settings/tokens
# HUGGINGFACE_TOKEN=your-hf-token
# SPEAKER_1_ROLE=client
# SPEAKER_2_ROLE=company_representative
