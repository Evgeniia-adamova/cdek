# Yandex Object Storage (S3). Copy to .env and fill in; never commit .env
YANDEX_S3_BUCKET=your-bucket-name
YANDEX_S3_ACCESS_KEY_ID=your-access-key-id
YANDEX_S3_SECRET_ACCESS_KEY=your-secret-access-key

# Optional: object key for pipeline video (e.g. video_files/xxx.webm). If unset, first video under video_files/ is used.
# YANDEX_VIDEO_KEY=video_files/your-video.webm
