{
  "language": "ru",
  "segments": [
    {
      "start": 0.0,
      "end": 5.0,
      "text": "Здравствуйте."
    },
    {
      "start": 5.0,
      "end": 8.040000000000001,
      "text": "Здравствуйте. Подскажите, пожалуйста, меня хорошо видно"
    },
    {
      "start": 8.040000000000001,
      "end": 11.040000000000001,
      "text": "слышно?"
    },
    {
      "start": 11.040000000000001,
      "end": 17.04,
      "text": "Алло, Елена."
    },
    {
      "start": 17.04,
      "end": 26.560000000000002,
      "text": "Елена, подскажите, меня хорошо слышно?"
    },
    {
      "start": 26.56,
      "end": 33.56,
      "text": "Алло."
    },
    {
      "start": 33.56,
      "end": 36.56,
      "text": "Алло."
    },
    {
      "start": 36.56,
      "end": 43.56,
      "text": "Так выключено."
    },
    {
      "start": 43.56,
      "end": 48.56,
      "text": "Так у меня есть."
    },
    {
      "start": 48.56,
      "end": 55.56,
      "text": "Мишка."
    },
    {
      "start": 55.56,
      "end": 66.56,
      "text": "Елена, подскажите, пожалуйста, слышите меня?"
    },
    {
      "start": 66.56,
      "end": 70.56,
      "text": "Меня хорошо слышно?"
    },
    {
      "start": 70.56,
      "end": 73.56,
      "text": "Все, замечательно."
    },
    {
      "start": 73.56,
      "end": 76.56,
      "text": "Теперь тоже вас услышало."
    },
    {
      "start": 76.56,
      "end": 80.56,
      "text": "Так, подскажите, пожалуйста."
    },
    {
      "start": 80.56,
      "end": 83.56,
      "text": "Как вам будет комфортнее, чтобы вы подключили демонстрацию"
    },
    {
      "start": 83.56,
      "end": 86.56,
      "text": "или меня подключить?"
    },
    {
      "start": 86.56,
      "end": 92.56,
      "text": "Вы подключите, пожалуйста."
    },
    {
      "start": 92.56,
      "end": 99.56,
      "text": "Ммм, буквально секундочку."
    },
    {
      "start": 99.56,
      "end": 109.56,
      "text": "Ммм."
    },
    {
      "start": 109.56,
      "end": 113.56,
      "text": "Так, мы сами сегодня будем рассматривать ваш личный кабинет."
    },
    {
      "start": 113.56,
      "end": 117.56,
      "text": "На всякий случай представлюсь меня зовут Полина."
    },
    {
      "start": 118.56,
      "end": 121.56,
      "text": "Как мы входим в первую очередь в личный кабинет?"
    },
    {
      "start": 121.56,
      "end": 125.56,
      "text": "Здесь необходимо нам в своем вести логин, либо има, ваш логин."
    },
    {
      "start": 125.56,
      "end": 133.56,
      "text": "Это ваш номер договора."
    },
    {
      "start": 133.56,
      "end": 136.56,
      "text": "Далее, соответственно, вы вставляете не помню пароль."
    },
    {
      "start": 136.56,
      "end": 138.56,
      "text": "Вот сюда вот кнопочку."
    },
    {
      "start": 138.56,
      "end": 145.56,
      "text": "Чтобы вам пришел пароль для восстановления на почту."
    },
    {
      "start": 145.56,
      "end": 152.56,
      "text": "Я, соответственно, пока покажу на тестом варианте."
    },
    {
      "start": 152.56,
      "end": 159.56,
      "text": "Так, подскажите, пожалуйста, как будете осуществлять поставки?"
    },
    {
      "start": 159.56,
      "end": 168.56,
      "text": "Вы продаете через авиты, в интернет-магазин или на маркет-плейсе?"
    },
    {
      "start": 168.56,
      "end": 173.56,
      "text": "Поставки не будет."
    },
    {
      "start": 173.56,
      "end": 177.56,
      "text": "Просто на правку патруки через дек будет."
    },
    {
      "start": 177.56,
      "end": 179.56,
      "text": "Черезов, Саран."
    },
    {
      "start": 179.56,
      "end": 181.56,
      "text": "Ммм, все, поняла, правильно?"
    },
    {
      "start": 181.56,
      "end": 185.56,
      "text": "Понимаю, что документы хотите отправлять?"
    },
    {
      "start": 185.56,
      "end": 187.56,
      "text": "Нет, вещи."
    },
    {
      "start": 187.56,
      "end": 188.56,
      "text": "Ммм, хорошо."
    },
    {
      "start": 188.56,
      "end": 196.56,
      "text": "Когда смотрите вам для вашей доставки, необходимо будет нажать новый заказ."
    },
    {
      "start": 196.56,
      "end": 199.56,
      "text": "Те, что он у нас прогрузится."
    },
    {
      "start": 199.56,
      "end": 203.56,
      "text": "Так как у вас тип договора к у, он называется доставка."
    },
    {
      "start": 203.56,
      "end": 205.56,
      "text": "Далее, соответственно, дополнительный тип."
    },
    {
      "start": 205.56,
      "end": 207.56,
      "text": "Нам здесь выбирать не нужно."
    },
    {
      "start": 207.56,
      "end": 209.56,
      "text": "Кем вы являетесь?"
    },
    {
      "start": 209.56,
      "end": 211.56,
      "text": "А правителем, получателем третьей стороной."
    },
    {
      "start": 211.56,
      "end": 215.56,
      "text": "Здесь вы выбираете подходящий для себя вариант."
    },
    {
      "start": 215.56,
      "end": 218.56,
      "text": "То есть, либо вы будете отправлять, либо получать либо третьей стороной."
    },
    {
      "start": 218.56,
      "end": 221.56,
      "text": "То есть, это осуществлять доставку между кем-то."
    },
    {
      "start": 221.56,
      "end": 226.56,
      "text": "Например, между у коллегами, между родственниками и так далее."
    },
    {
      "start": 226.56,
      "end": 230.56,
      "text": "Далее, оплата ставим под договору."
    },
    {
      "start": 230.56,
      "end": 233.56,
      "text": "То есть, чтобы с вашего счета списывалось,"
    },
    {
      "start": 233.56,
      "end": 237.56,
      "text": "город отправителя это откуда вы будете отправлять."
    },
    {
      "start": 237.56,
      "end": 241.56,
      "text": "То есть, это либо вы от себя отправляете, либо вам отправляют откуда вы."
    },
    {
      "start": 241.56,
      "end": 244.56,
      "text": "А откуда планируете отправлять?"
    },
    {
      "start": 246.56,
      "end": 248.56,
      "text": "Вы сейчас меня спрашиваете?"
    },
    {
      "start": 248.56,
      "end": 250.56,
      "text": "Да, спрашиваем."
    },
    {
      "start": 250.56,
      "end": 253.56,
      "text": "Да, на момент город есть синтуки."
    },
    {
      "start": 253.56,
      "end": 255.56,
      "text": "Угу."
    },
    {
      "start": 261.56,
      "end": 264.56,
      "text": "Угу, тес у нас прогрузит."
    },
    {
      "start": 283.56,
      "end": 285.56,
      "text": "Да, секунду."
    },
    {
      "start": 285.56,
      "end": 287.56,
      "text": "Да, секунду."
    },
    {
      "start": 309.56,
      "end": 313.56,
      "text": "Угу, куда отправлять будете?"
    },
    {
      "start": 314.56,
      "end": 317.56,
      "text": "Бород ярца-восмоленской области."
    },
    {
      "start": 322.56,
      "end": 323.56,
      "text": "Так, далее."
    },
    {
      "start": 323.56,
      "end": 327.56,
      "text": "Видим, что у нас есть информация об отправителя и ополучателя."
    },
    {
      "start": 327.56,
      "end": 332.56,
      "text": "Отправитель, если вы, то, соответственно, все данные ваши автоматические подтягиваются."
    },
    {
      "start": 332.56,
      "end": 334.56,
      "text": "Получателя нужно будет указывать."
    },
    {
      "start": 334.56,
      "end": 337.56,
      "text": "Если, соответственно, меняем, что вы будете получать,"
    },
    {
      "start": 337.56,
      "end": 340.56,
      "text": "а кто-то другой отправляет, то вам, соответственно,"
    },
    {
      "start": 340.56,
      "end": 345.56,
      "text": "будет заполнить данные отправителя, а получателям будете выступать вы."
    },
    {
      "start": 345.56,
      "end": 349.56,
      "text": "Получать будет Юр лицо или Физлицо."
    },
    {
      "start": 349.56,
      "end": 351.56,
      "text": "Получателям?"
    },
    {
      "start": 351.56,
      "end": 354.56,
      "text": "У Физлицо."
    },
    {
      "start": 354.56,
      "end": 356.56,
      "text": "Угу, хорошо."
    },
    {
      "start": 356.56,
      "end": 361.56,
      "text": "Здесь, соответственно, с вами вводим его ФИО."
    },
    {
      "start": 361.56,
      "end": 363.56,
      "text": "К примеру, Иванов и Иван Иванович."
    },
    {
      "start": 363.56,
      "end": 367.56,
      "text": "Нужно водить ФИО полностью и контактные номер телефона."
    },
    {
      "start": 367.56,
      "end": 371.56,
      "text": "Для того, чтобы в случае необходимости, мы смогли с получателем связаться."
    },
    {
      "start": 371.56,
      "end": 376.56,
      "text": "Далее мы с вами заполняем информацию о грузом месте."
    },
    {
      "start": 376.56,
      "end": 380.56,
      "text": "Что конкретно планируете отправлять?"
    },
    {
      "start": 380.56,
      "end": 382.56,
      "text": "Вещи."
    },
    {
      "start": 382.56,
      "end": 385.56,
      "text": "Вещи личного характера, возможно."
    },
    {
      "start": 385.56,
      "end": 387.56,
      "text": "Да."
    },
    {
      "start": 387.56,
      "end": 392.56,
      "text": "Соответственно, здесь мы с вами тогда указываем вес коробки."
    },
    {
      "start": 392.56,
      "end": 396.56,
      "text": "То есть грузоместо этой коробка с вещами внутри."
    },
    {
      "start": 396.56,
      "end": 399.56,
      "text": "Допустим, она будет 21 килограмм."
    },
    {
      "start": 399.56,
      "end": 404.56,
      "text": "Будет, например, 30 на 30 к примеру."
    },
    {
      "start": 404.56,
      "end": 407.56,
      "text": "Далее, описание груза."
    },
    {
      "start": 407.56,
      "end": 411.56,
      "text": "Здесь мы заполняем максимально подробно."
    },
    {
      "start": 411.56,
      "end": 416.56,
      "text": "То есть, селищные вещи, например."
    },
    {
      "start": 416.56,
      "end": 418.56,
      "text": "Где же то?"
    },
    {
      "start": 418.56,
      "end": 421.56,
      "text": "Сезонное зимнее."
    },
    {
      "start": 421.56,
      "end": 423.56,
      "text": "Вот так вот."
    },
    {
      "start": 423.56,
      "end": 426.56,
      "text": "Для чего это необходимо, чтобы в случае,"
    },
    {
      "start": 426.56,
      "end": 429.56,
      "text": "а если вдруг с грузом что-то случилось,"
    },
    {
      "start": 429.56,
      "end": 433.56,
      "text": "чтобы мы смогли его идентифицировать, что это действительно ваш груз."
    },
    {
      "start": 433.56,
      "end": 436.56,
      "text": "Далее мы сохраняем изменение."
    },
    {
      "start": 436.56,
      "end": 441.56,
      "text": "Видим, что у нас здесь с вами при необходимости также указывается объемный вес."
    },
    {
      "start": 441.56,
      "end": 444.56,
      "text": "Оплаты всегда считаются по объемному весу,"
    },
    {
      "start": 444.56,
      "end": 446.56,
      "text": "то есть по большему весу."
    },
    {
      "start": 446.56,
      "end": 450.56,
      "text": "Это тот максимум, который может уместиться в эту коробку."
    },
    {
      "start": 450.56,
      "end": 452.56,
      "text": "Далее мы с вами соответственно выбираем тарифы."
    },
    {
      "start": 452.56,
      "end": 455.56,
      "text": "Здесь у нас есть два варианта."
    },
    {
      "start": 455.56,
      "end": 457.56,
      "text": "Откуда и куда? Откуда?"
    },
    {
      "start": 457.56,
      "end": 461.56,
      "text": "Принести в ПВЗ либо заберет курьер."
    },
    {
      "start": 461.56,
      "end": 465.56,
      "text": "Принести в ПВЗ это вы относите коробку в ПВЗ."
    },
    {
      "start": 465.56,
      "end": 468.56,
      "text": "Там, допустим, если вы не уверены в габаритах и в весе,"
    },
    {
      "start": 468.56,
      "end": 471.56,
      "text": "и делай еще раз перемиряю."
    },
    {
      "start": 471.56,
      "end": 474.56,
      "text": "И соответственно, вносит изменение."
    },
    {
      "start": 474.56,
      "end": 477.56,
      "text": "Если курьер, то соответственно к вам курьер приезжает на адрес,"
    },
    {
      "start": 477.56,
      "end": 479.56,
      "text": "чтобы забрать в этот груз."
    },
    {
      "start": 479.56,
      "end": 483.56,
      "text": "Также куда доставить ПВЗ по стамат курьером?"
    },
    {
      "start": 483.56,
      "end": 486.56,
      "text": "Тут как получать у любудет комфортнее."
    },
    {
      "start": 486.56,
      "end": 488.56,
      "text": "То есть либо также ПВЗ либо курьером."
    },
    {
      "start": 488.56,
      "end": 492.56,
      "text": "По стаматы принимают не все габариты грузов."
    },
    {
      "start": 492.56,
      "end": 495.56,
      "text": "То есть здесь нужно будет это учитывать."
    },
    {
      "start": 496.56,
      "end": 500.56,
      "text": "Самый оптимальный вариант для нас сейчас это express склад склад."
    },
    {
      "start": 500.56,
      "end": 503.56,
      "text": "Соответственно, здесь он идет 6 дней"
    },
    {
      "start": 503.56,
      "end": 506.56,
      "text": "и самый оптимальный по цене для нас."
    },
    {
      "start": 507.56,
      "end": 512.56,
      "text": "Далее, соответственно, дополнительные услуги, если они вам необходимо."
    },
    {
      "start": 512.56,
      "end": 517.56,
      "text": "Это внутреннее ближатка, сама коробка, стрыч, пленка, пупырка."
    },
    {
      "start": 519.56,
      "end": 522.56,
      "text": "То есть здесь по необходимости заполняете."
    },
    {
      "start": 522.56,
      "end": 529.56,
      "text": "Если вам это ничего не нужно, то соответственно ничего далее не добавляем."
    },
    {
      "start": 531.56,
      "end": 533.56,
      "text": "Информация об отправлении."
    },
    {
      "start": 533.56,
      "end": 536.56,
      "text": "Здесь вы можете посмотреть ли себя ближайшие ПВЗ,"
    },
    {
      "start": 536.56,
      "end": 539.56,
      "text": "где вам будет комфортнее куда отнести."
    },
    {
      "start": 539.56,
      "end": 544.56,
      "text": "Также пункты куда доставляем, здесь можно выбрать конкретный адрес."
    },
    {
      "start": 547.56,
      "end": 550.56,
      "text": "Принести в ПВЗ можно любой."
    },
    {
      "start": 550.56,
      "end": 553.56,
      "text": "Забрать можно будет только из какого-то конкретного ПВЗ."
    },
    {
      "start": 553.56,
      "end": 557.56,
      "text": "Если это крупный габаритный груз, то соответственно, допустим,"
    },
    {
      "start": 557.56,
      "end": 560.56,
      "text": "более 35 килограмм, то нужно будет проверять."
    },
    {
      "start": 560.56,
      "end": 562.56,
      "text": "Может ли ПВЗ принять такой груз?"
    },
    {
      "start": 562.56,
      "end": 564.56,
      "text": "То есть здесь в видне весто 100 килограмм."
    },
    {
      "start": 564.56,
      "end": 567.56,
      "text": "Соответственно, более 35 он точно примет."
    },
    {
      "start": 568.56,
      "end": 570.56,
      "text": "Его соответственно выбираем."
    },
    {
      "start": 570.56,
      "end": 573.56,
      "text": "Всё, по факту, вот наша накладная создана."
    },
    {
      "start": 574.56,
      "end": 579.56,
      "text": "Тлотюшки, тебе на голову в таком доме и вскопировали,"
    },
    {
      "start": 579.56,
      "end": 581.56,
      "text": "как обеспечали."
    },
    {
      "start": 581.56,
      "end": 583.56,
      "text": "Здесь выставки."
    },
    {
      "start": 583.56,
      "end": 585.56,
      "text": "Я про голову в одной тлотюшки, всяко ведомости."
    },
    {
      "start": 585.56,
      "end": 587.56,
      "text": "Леньше, без зата-платы, пока вы козлили."
    },
    {
      "start": 587.56,
      "end": 588.56,
      "text": "Алло, Полинг."
    },
    {
      "start": 588.56,
      "end": 590.56,
      "text": "Да, я вас слышу."
    },
    {
      "start": 590.56,
      "end": 594.56,
      "text": "Скажите, а вот данный момент я могу туда-то накладную создать на месте,"
    },
    {
      "start": 594.56,
      "end": 596.56,
      "text": "когда я до веду."
    },
    {
      "start": 596.56,
      "end": 597.56,
      "text": "Да, да."
    },
    {
      "start": 597.56,
      "end": 602.56,
      "text": "В случае необходимости вы соответственно также переходите на сайт,"
    },
    {
      "start": 602.56,
      "end": 605.56,
      "text": "с телефона, вместе с коллегами,"
    },
    {
      "start": 605.56,
      "end": 607.56,
      "text": "из ПВЗ можно это создать."
    },
    {
      "start": 607.56,
      "end": 609.56,
      "text": "Либо, соответственно, также с нами на связи,"
    },
    {
      "start": 609.56,
      "end": 613.56,
      "text": "через нашу с вами переписку в мессенджере."
    },
    {
      "start": 615.56,
      "end": 616.56,
      "text": "Ихи такой вопрос."
    },
    {
      "start": 616.56,
      "end": 620.56,
      "text": "Смотрите, я, если у меня положила насчёт сумму."
    },
    {
      "start": 620.56,
      "end": 621.56,
      "text": "Вот."
    },
    {
      "start": 621.56,
      "end": 625.56,
      "text": "А она сразу приходит для людей, что они там искали."
    },
    {
      "start": 625.56,
      "end": 629.56,
      "text": "В течение трёх дней, но в любом случае вы уже сейчас можете"
    },
    {
      "start": 629.56,
      "end": 632.56,
      "text": "составлять накладные и соответственно отправлять."
    },
    {
      "start": 632.56,
      "end": 635.56,
      "text": "То есть я могу сегодня сходить, отправить,"
    },
    {
      "start": 635.56,
      "end": 638.56,
      "text": "да, потом автоматом там всё спишется."
    },
    {
      "start": 638.56,
      "end": 639.56,
      "text": "Да, да, спишется."
    },
    {
      "start": 639.56,
      "end": 640.56,
      "text": "Попробуйте денег с лошади."
    },
    {
      "start": 640.56,
      "end": 643.56,
      "text": "Смотрите, что очень важно."
    },
    {
      "start": 643.56,
      "end": 645.56,
      "text": "Списывается, она только при вручении игру,"
    },
    {
      "start": 645.56,
      "end": 647.56,
      "text": "то есть как только груз будет вручен."
    },
    {
      "start": 647.56,
      "end": 650.56,
      "text": "Здесь у нас с вами доставка будет идти шейз дней."
    },
    {
      "start": 652.56,
      "end": 654.56,
      "text": "Соответственно, только через шейз дней"
    },
    {
      "start": 654.56,
      "end": 657.56,
      "text": "будет это списание после того, как человек его получит."
    },
    {
      "start": 658.56,
      "end": 659.56,
      "text": "Влекалепно."
    },
    {
      "start": 659.56,
      "end": 663.56,
      "text": "А вот я сейчас когда сдам груст,"
    },
    {
      "start": 663.56,
      "end": 665.56,
      "text": "я уже буду знать на какую сумму, да?"
    },
    {
      "start": 665.56,
      "end": 666.56,
      "text": "Какая сумма спишется?"
    },
    {
      "start": 666.56,
      "end": 667.56,
      "text": "Да."
    },
    {
      "start": 667.56,
      "end": 669.56,
      "text": "Если, например, кажется, она будет больше,"
    },
    {
      "start": 669.56,
      "end": 670.56,
      "text": "я должна буду дополнить."
    },
    {
      "start": 672.56,
      "end": 676.56,
      "text": "Смотрите, если она выйдет более того аванса,"
    },
    {
      "start": 676.56,
      "end": 678.56,
      "text": "который вы ранее в насилие,"
    },
    {
      "start": 678.56,
      "end": 680.56,
      "text": "если не ошибаюсь, то это 490,"
    },
    {
      "start": 680.56,
      "end": 681.56,
      "text": "она сили, верно?"
    },
    {
      "start": 682.56,
      "end": 683.56,
      "text": "Ну да."
    },
    {
      "start": 683.56,
      "end": 685.56,
      "text": "Вот, соответственно, если больше этого,"
    },
    {
      "start": 685.56,
      "end": 689.56,
      "text": "то, соответственно, да, нужно будет еще направить остатки."
    },
    {
      "start": 689.56,
      "end": 691.56,
      "text": "Но я не думаю, что будет."
    },
    {
      "start": 691.56,
      "end": 692.56,
      "text": "Смотрите, что это было."
    },
    {
      "start": 694.56,
      "end": 696.56,
      "text": "Соответственно, в любом случае,"
    },
    {
      "start": 696.56,
      "end": 700.56,
      "text": "если вдруг вы хотите еще допустим положить средства,"
    },
    {
      "start": 700.56,
      "end": 702.56,
      "text": "в независимости от того,"
    },
    {
      "start": 702.56,
      "end": 704.56,
      "text": "что у вас есть сейчас, вы также можете написать нам."
    },
    {
      "start": 704.56,
      "end": 706.56,
      "text": "Раз неделю составляются счита,"
    },
    {
      "start": 706.56,
      "end": 709.56,
      "text": "соответственно, направляются вам на почту для оплаты."
    },
    {
      "start": 712.56,
      "end": 713.56,
      "text": "Понял."
    },
    {
      "start": 713.56,
      "end": 714.56,
      "text": "Не срез."
    },
    {
      "start": 714.56,
      "end": 715.56,
      "text": "Вы положите, чтобы они там лежали."
    },
    {
      "start": 717.56,
      "end": 718.56,
      "text": "Поняла, поняла."
    },
    {
      "start": 719.56,
      "end": 722.56,
      "text": "Подскажите, пожалуйста, есть ли еще"
    },
    {
      "start": 722.56,
      "end": 724.56,
      "text": "какой-то вопрос по личному кабинету?"
    },
    {
      "start": 726.56,
      "end": 727.56,
      "text": "Нет."
    },
    {
      "start": 727.56,
      "end": 728.56,
      "text": "Спасибо."
    },
    {
      "start": 728.56,
      "end": 730.56,
      "text": "Когда, смотрите, еще пару моментов."
    },
    {
      "start": 730.56,
      "end": 733.56,
      "text": "Когда мы с вами создаем накладную,"
    },
    {
      "start": 733.56,
      "end": 736.56,
      "text": "после этого у нас появляется списки заказов,"
    },
    {
      "start": 736.56,
      "end": 738.56,
      "text": "номер нашего отправления,"
    },
    {
      "start": 738.56,
      "end": 741.56,
      "text": "и, соответственно, можно распечатать накладную и штрих код."
    },
    {
      "start": 741.56,
      "end": 744.56,
      "text": "Все на отправление всегда должны быть проморокированы."
    },
    {
      "start": 744.56,
      "end": 746.56,
      "text": "Если пойдете, соответственно, составляйте ПВЗ,"
    },
    {
      "start": 746.56,
      "end": 748.56,
      "text": "вы можете прямо там коллег попросить,"
    },
    {
      "start": 748.56,
      "end": 751.56,
      "text": "распечатать и штрих код и накладную."
    },
    {
      "start": 751.56,
      "end": 753.56,
      "text": "Также, соответственно, очень важно просить их"
    },
    {
      "start": 753.56,
      "end": 755.56,
      "text": "при необходимости перемирять груст."
    },
    {
      "start": 755.56,
      "end": 757.56,
      "text": "То есть это взвесить его еще раз"
    },
    {
      "start": 757.56,
      "end": 760.56,
      "text": "и сравнить губориты верные или вы указали заранее."
    },
    {
      "start": 761.56,
      "end": 762.56,
      "text": "Вот этот номер вашего заказа"
    },
    {
      "start": 762.56,
      "end": 765.56,
      "text": "это по факту номер накладной и номер отправления."
    },
    {
      "start": 767.56,
      "end": 769.56,
      "text": "Если будут какие-то вопросы, вы его спокойно копируете"
    },
    {
      "start": 769.56,
      "end": 771.56,
      "text": "и можете писать нам в мессеншер."
    },
    {
      "start": 771.56,
      "end": 773.56,
      "text": "Там, допустим, не совсем понимаю,"
    },
    {
      "start": 773.56,
      "end": 775.56,
      "text": "где находится мое отправление, например."
    },
    {
      "start": 776.56,
      "end": 779.56,
      "text": "Или если нужно внести какие-то корректировки."
    },
    {
      "start": 782.56,
      "end": 783.56,
      "text": "С его поняла, хорошо."
    },
    {
      "start": 784.56,
      "end": 786.56,
      "text": "Замечательно тогда, Елена."
    },
    {
      "start": 786.56,
      "end": 788.56,
      "text": "Если будут еще какие-то вопросы возникает,"
    },
    {
      "start": 788.56,
      "end": 790.56,
      "text": "будем ожидать их у нас в мессеншере."
    },
    {
      "start": 790.56,
      "end": 791.56,
      "text": "Так говорились?"
    },
    {
      "start": 792.56,
      "end": 793.56,
      "text": "Моговорились."
    },
    {
      "start": 794.56,
      "end": 795.56,
      "text": "Замечательно тогда."
    },
    {
      "start": 796.56,
      "end": 798.56,
      "text": "Спасибо вам, что подключились."
    },
    {
      "start": 798.56,
      "end": 800.56,
      "text": "Тогда хорошего дня и удачной отправки."
    },
    {
      "start": 802.56,
      "end": 803.56,
      "text": "Почти от свидания."
    },
    {
      "start": 803.56,
      "end": 804.56,
      "text": "До свидания."
    }
  ]
}